# Copy this file to `.env` in the project root and fill in YOUR real values.
# Never commit `.env` — it is listed in .gitignore.
# Do not put real passwords or API secrets in `.env.example` (this file is often committed to git).

# MongoDB Atlas → Connect → Drivers → connection string (replace <password> and db name if needed)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/trendnest?retryWrites=true&w=majority

# Cloudinary → Dashboard → API Keys (keep API secret only in `.env` on the server machine)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# API port: unset defaults to 5000 (Railway etc. inject PORT). For local Vite proxy to 127.0.0.1:5050, use PORT=5050.
PORT=5050

# Frontend production: full URL to your deployed API (no trailing slash).
# .env.production in the repo sets Render; override in your host build env if needed.
# VITE_API_BASE_URL=https://trendnest-custom-shop.onrender.com

# --- Orders & admin API (server / Render) ---
# Secret for GET/PATCH /api/orders and invoice PDF. Admins paste this once per browser (sessionStorage).
ADMIN_API_KEY=generate_a_long_random_string

# --- Customer auth (OTP + cookie session) ---
# Required secret for express-session.
SESSION_SECRET=generate_a_long_random_string
# Session lifetime (ms). Default is 7 days.
SESSION_TTL_MS=604800000
# Cross-site cookies (Vercel frontend + Render API). In production use SameSite=None + Secure.
# Single origin, or use FRONTEND_ORIGINS for multiple (production + preview + www), comma-separated.
FRONTEND_ORIGIN=https://your-frontend.vercel.app
# FRONTEND_ORIGINS=https://app.vercel.app,https://myapp-git-main-user.vercel.app
COOKIE_SAMESITE=none
COOKIE_SECURE=true
# OTP settings (email OTP).
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Password hashing work factor.
PASSWORD_HASH_ITERS=120000

# Gmail SMTP (use an App Password, not your normal password): https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=trendnest099@gmail.com
SMTP_PASS=
ORDER_FROM_EMAIL=trendnest099@gmail.com
# Where to send "new order" alerts (can be the same inbox)
ORDER_ADMIN_EMAIL=trendnest099@gmail.com
