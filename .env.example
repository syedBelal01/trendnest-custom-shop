# Copy this file to `.env` in the project root and fill in YOUR real values.
# Never commit `.env` — it is listed in .gitignore.
# Do not put real passwords or API secrets in `.env.example` (this file is often committed to git).

# MongoDB Atlas → Connect → Drivers → connection string (replace <password> and db name if needed)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/trendnest?retryWrites=true&w=majority

# Cloudinary → Dashboard → API Keys (keep API secret only in `.env` on the server machine)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# API port: unset defaults to 5000 (Railway etc. inject PORT). For local Vite proxy to 127.0.0.1:5050, use PORT=5050.
PORT=5050

# Frontend production: full URL to your deployed API (no trailing slash).
# .env.production in the repo sets Render; override in your host build env if needed.
# VITE_API_BASE_URL=https://trendnest-custom-shop.onrender.com

# --- Orders & admin API (server / Render) ---
# Secret for GET/PATCH /api/orders and invoice PDF. Admins paste this once per browser (sessionStorage).
ADMIN_API_KEY=generate_a_long_random_string

# Days after delivery that a customer may request a return (default 7).
RETURN_WINDOW_DAYS=7

# --- Customer auth (OTP + cookie session) ---
# Required secret for express-session.
SESSION_SECRET=generate_a_long_random_string
# Session lifetime (ms). Default is 7 days.
SESSION_TTL_MS=604800000
# Cross-site cookies (Vercel frontend + Render API). In production use SameSite=None + Secure.
# HTTPS is required when COOKIE_SECURE=true. Origins must match the deployed site exactly
# (https vs http, www vs apex) or the browser will not send cookies on /api/auth/* (mobile Safari included).
# Single origin, or use FRONTEND_ORIGINS for multiple (production + preview + www), comma-separated.
# On Render: set FRONTEND_ORIGIN to your live Vercel URL and add every preview URL you use to FRONTEND_ORIGINS,
# or set ALLOW_VERCEL_PREVIEW_ORIGINS=true to allow all https://*.vercel.app (easier for previews).
FRONTEND_ORIGIN=https://your-frontend.vercel.app
# FRONTEND_ORIGINS=https://app.vercel.app,https://myapp-git-main-user.vercel.app
ALLOW_VERCEL_PREVIEW_ORIGINS=true
COOKIE_SAMESITE=none
COOKIE_SECURE=true
# OTP settings (email OTP).
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Future: SMS OTP to verify Indian mobile at checkout/login (Twilio, MSG91, etc.). Not implemented yet; keep false.
# PHONE_OTP_ENABLED=false

# Password hashing work factor.
PASSWORD_HASH_ITERS=120000

# Gmail SMTP (use an App Password, not your normal password): https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=trendnest099@gmail.com
SMTP_PASS=
ORDER_FROM_EMAIL=trendnest099@gmail.com
# Where to send "new order" alerts (can be the same inbox)
ORDER_ADMIN_EMAIL=trendnest099@gmail.com

# --- Shiprocket (courier rates, AWB, webhooks) ---
# Store credentials only in environment variables / your host secret store — never commit real values.
# Missing email/password logs a warning and disables live rates; checkout still runs if ALLOW_CHECKOUT_WITHOUT_SHIPPING_QUOTE=true.
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_LOCATION_NAME=
# SHIPROCKET_PICKUP_PINCODE=
# If the API omits a parseable delivery estimate, assume this many days (default 5).
# SHIPROCKET_FALLBACK_ETA_DAYS=5
# After failed Shiprocket login, pause new auth attempts (ms). Default 90000.
# SHIPROCKET_AUTH_FAILURE_COOLDOWN_MS=90000
# Automated shipment attempts before marking manualRequired (default 4).
# SHIPROCKET_SHIPMENT_MAX_ATTEMPTS=4
# Exponential backoff base delay between shipment retries (ms). Default 2000; max cap default 120000.
# SHIPROCKET_SHIPMENT_RETRY_BASE_MS=2000
# SHIPROCKET_SHIPMENT_RETRY_MAX_MS=120000
#
# Relaxed checkout (development, testing, or rare production fallback only):
# - When true: orders may be placed with provisional ₹0 shipping; the API logs checkout.order_relaxed_shipping and
#   runs a background job to pull the real Shiprocket quote and update totals / flags.
# - GET /api/health exposes allowCheckoutWithoutShippingQuote for the storefront (cached ~60s in the browser).
# Recommended for production: leave unset or false so every order requires a confirmed quote at checkout.
# ALLOW_CHECKOUT_WITHOUT_SHIPPING_QUOTE=false
